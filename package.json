{
  "name": "minecraft-addons-tools",
  "version": "1.0.0",
  "description": "Node.js tools and utilities for Minecraft data packs and server management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build"
  },
  "keywords": [
    "minecraft",
    "data-pack",
    "plugin",
    "tools",
    "server"
  ],
  "author": "nobody174 <nobodylearn174@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "commander": "^11.1.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nobody174/minecraft-addons.git"
  },
  "bugs": {
    "url": "https://github.com/nobody174/minecraft-addons/issues"
  },
  "homepage": "https://github.com/nobody174/minecraft-addons#readme"
}
